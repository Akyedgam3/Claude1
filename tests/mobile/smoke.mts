import { chromium } from '@playwright/test';
import fs from 'node:fs';
import { issueLicense } from '../../src/license/license';
const devKey = fs.readFileSync('dev-keys/license-private.dev.pem', 'utf8');
const S = process.argv[2] ?? '/tmp';
const b = await chromium.launch();
const ctx = await b.newContext({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 2, isMobile: true, hasTouch: true });
const p = await ctx.newPage();
const errs: string[] = [];
p.on('pageerror', (e) => errs.push('pageerror: ' + e.message));
p.on('console', (m) => m.type() === 'error' && errs.push('console: ' + m.text().slice(0, 300)));
await p.goto('http://127.0.0.1:8790/index.html');
await p.getByText('بصمة الجهاز', { exact: true }).waitFor({ timeout: 20000 });
const machineId = (await p.locator('.big-code').first().innerText()).trim();
console.log('machineId', machineId);
await p.screenshot({ path: `${S}/m1-lock.png` });
const key = issueLicense({ customer: 'تجربة موبايل', machineId, plan: 'annual' }, devKey);
await p.locator('textarea').first().fill(key);
await p.getByRole('button', { name: 'تفعيل', exact: true }).click();
await p.waitForTimeout(800);
console.log('toast:', await p.locator('.toast').allInnerTexts());
try { await p.getByText('شركة جديدة').first().waitFor({ timeout: 20000 }); } catch (e) { await p.screenshot({ path: `${S}/m-fail.png` }); console.log(JSON.stringify(errs, null, 1)); console.log((await p.locator('body').innerText()).slice(0, 600)); throw e; }
await p.screenshot({ path: `${S}/m2-welcome.png` });
await p.getByRole('button', { name: 'شركة جديدة' }).click();
await p.locator('.activity', { hasText: 'سوبرماركت' }).click();
await p.locator('.field', { hasText: 'اسم الشركة' }).locator('input').fill('ماركت الموبايل');
await p.locator('.field', { hasText: 'اسمك' }).locator('input').fill('المالك');
await p.locator('.field', { hasText: 'كلمة السر (6' }).locator('input').fill('secret123');
await p.locator('.field', { hasText: 'تأكيد كلمة السر' }).locator('input').fill('secret123');
await p.locator('.demo-check input').check();
const t0 = Date.now();
await p.getByRole('button', { name: 'إنشاء الشركة' }).click();
await p.getByRole('button', { name: 'حفظته، تابع' }).waitFor({ timeout: 60000 });
console.log('create ms', Date.now() - t0);
await p.getByRole('button', { name: 'حفظته، تابع' }).click();
await p.waitForTimeout(1500);
await p.screenshot({ path: `${S}/m3-dashboard.png` });
// إعادة فتح التطبيق: لازم الشركة تضل موجودة
await p.waitForTimeout(1500);
await p.reload();
await p.waitForTimeout(3000);
await p.screenshot({ path: `${S}/m4-reload.png` });
console.log('after reload has company:', await p.getByText('ماركت الموبايل').count());
console.log(JSON.stringify(errs, null, 1));
await b.close();

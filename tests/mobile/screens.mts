import { chromium, type Page } from '@playwright/test';
import fs from 'node:fs';
import { issueLicense } from '../../src/license/license';
const devKey = fs.readFileSync('dev-keys/license-private.dev.pem', 'utf8');
const S = process.argv[2] ?? '/tmp';
const [W, H] = (process.argv[3] ?? '390x844').split('x').map(Number) as [number, number];
const tag = process.argv[4] ?? 'p';
const b = await chromium.launch();
const ctx = await b.newContext({ viewport: { width: W, height: H }, deviceScaleFactor: 2, isMobile: true, hasTouch: true });
const p = await ctx.newPage();
const errs: string[] = [];
p.on('pageerror', (e) => errs.push('pageerror: ' + e.message));
p.on('console', (m) => m.type() === 'error' && errs.push('console: ' + m.text().slice(0, 300)));
await p.addInitScript(() => localStorage.setItem('mizan.tour.off', '1'));
await p.goto('http://127.0.0.1:8790/index.html');
await p.getByText('بصمة الجهاز', { exact: true }).waitFor({ timeout: 20000 });
const machineId = (await p.locator('.big-code').first().innerText()).trim();
await p.locator('textarea').first().fill(issueLicense({ customer: 'تجربة', machineId, plan: 'annual' }, devKey));
await p.getByRole('button', { name: 'تفعيل', exact: true }).click();
await p.getByText('شركة جديدة').first().click();
await p.locator('.activity', { hasText: 'سوبرماركت' }).click();
await p.locator('.field', { hasText: 'اسم الشركة' }).locator('input').fill('ماركت الموبايل');
await p.locator('.field', { hasText: 'اسمك' }).locator('input').fill('المالك');
await p.locator('.field', { hasText: 'كلمة السر (6' }).locator('input').fill('secret123');
await p.locator('.field', { hasText: 'تأكيد كلمة السر' }).locator('input').fill('secret123');
await p.locator('.demo-check input').check();
await p.getByRole('button', { name: 'إنشاء الشركة' }).click();
await p.getByRole('button', { name: 'حفظته، تابع' }).click();
const shot = async (n: string) => { await p.waitForTimeout(500); await p.screenshot({ path: `${S}/${tag}-${n}.png` }); };
const go = async (label: string) => {
  if (await p.locator('.mobile-bar .menu').isVisible()) await p.locator('.mobile-bar .menu').click();
  await p.locator('.sidebar nav button', { hasText: label }).first().click();
};
await shot('1-dashboard');
if (await p.locator('.bottom-nav').isVisible()) {
  await p.locator('.bottom-nav button', { hasText: 'المزيد' }).click();
  await shot('2-drawer');
  await p.locator('.nav-backdrop').click({ position: { x: 10, y: 300 } });
  await p.locator('.bottom-nav button', { hasText: 'البيع' }).click();
} else await go('نقطة البيع');
await p.locator('.pos-item').first().click();
await p.locator('.pos-item').nth(1).click();
await shot('3-pos');
if (await p.locator('.m-cart-bar').isVisible()) {
  await p.locator('.m-cart-bar').click();
  await shot('3b-cart');
}
await p.getByRole('button', { name: 'دفع نقداً' }).click();
await p.waitForTimeout(800);
await go('فاتورة مبيع');
await shot('4-sale');
await go('سجل الفواتير');
await shot('5-invoices');
await p.locator('table.table tbody tr').first().click();
await shot('6-invoice');
await go('الديون');
await shot('7-debts');
await go('التقارير');
await shot('8-reports');
await go('المواد');
await shot('9-items');
await go('الإعدادات');
await shot('10-settings');
console.log(JSON.stringify(errs, null, 1));
await b.close();

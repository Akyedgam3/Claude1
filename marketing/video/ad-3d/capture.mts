// لقطات الجوال الحقيقية لإعلان adx (390×844 ×3)
import { chromium, type Page } from 'playwright';
import fs from 'node:fs';
import { issueLicense } from '/home/user/Claude1/src/license/license';
const devKey = fs.readFileSync('/home/user/Claude1/dev-keys/license-private.dev.pem', 'utf8');
const OUT = process.argv[2]!;
const b = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium-1243/chrome-linux64/chrome' });
const ctx = await b.newContext({ viewport: { width: 390, height: 844 }, deviceScaleFactor: 3, isMobile: true, hasTouch: true });
const p = await ctx.newPage();
await p.addInitScript(() => localStorage.setItem('mizan.tour.off', '1'));
await p.goto('http://127.0.0.1:8790/index.html');
await p.getByText('بصمة الجهاز', { exact: true }).waitFor({ timeout: 30000 });
const machineId = (await p.locator('.big-code').first().innerText()).trim();
await p.locator('textarea').first().fill(issueLicense({ customer: 'ت', machineId, plan: 'annual' }, devKey));
await p.getByRole('button', { name: 'تفعيل', exact: true }).click();
await p.getByText('شركة جديدة').first().click();
await p.locator('.activity', { hasText: 'سوبرماركت' }).click();
await p.locator('.field', { hasText: 'اسم الشركة' }).locator('input').fill('سوبرماركت الخير');
await p.locator('.field', { hasText: 'اسمك' }).locator('input').fill('أبو محمد');
await p.locator('.field', { hasText: 'كلمة السر (6' }).locator('input').fill('secret123');
await p.locator('.field', { hasText: 'تأكيد كلمة السر' }).locator('input').fill('secret123');
await p.locator('.demo-check input').check();
await p.getByRole('button', { name: 'إنشاء الشركة' }).click();
await p.getByRole('button', { name: 'حفظته، تابع' }).click({ timeout: 60000 });
await p.addStyleTag({ content: '.toast{display:none!important} *{caret-color:transparent!important} *{animation-duration:0s!important;transition-duration:0s!important}' });
await p.waitForTimeout(900);
const top = () => p.evaluate(() => document.querySelector('.content')?.scrollTo(0, 0));
const shot = async (n: string, wait = 900) => { await p.waitForTimeout(wait); await p.screenshot({ path: `${OUT}/${n}.png` }); console.log('shot', n); };
const menu = async (name: string) => { await p.locator('.mobile-bar .menu').click(); await p.waitForTimeout(400); await p.locator('.sidebar nav button', { hasText: name }).first().click(); await p.waitForTimeout(700); await top(); };
const safe = async (n: string, fn: () => Promise<void>) => { try { await fn(); } catch (e) { console.log('FAIL', n, (e as Error).message.split('\n')[0]); } };
await top(); await shot('m-home');
await safe('sale', async () => {
  await p.locator('.content button', { hasText: 'فاتورة مبيع' }).first().click();
  for (const q of ['رز', 'سكر', 'شاي']) { await p.locator('.lines .picker input, table.lines .picker input').last().click(); await p.keyboard.type(q); await p.waitForTimeout(350); await p.keyboard.press('Enter'); await p.waitForTimeout(350); }
  await top(); await shot('m-sale');
  await p.getByRole('button', { name: /حفظ الفاتورة/ }).first().click(); await p.waitForTimeout(1200); await top(); await shot('m-invoice');
});
await safe('items', async () => { await menu('المواد'); await shot('m-items'); });
await safe('watch', async () => { await menu('مراقبة المواد'); await shot('m-watch'); });
await safe('debts', async () => { await p.locator('.bottom-nav button', { hasText: 'الديون' }).click(); await top(); await shot('m-debts'); });
await safe('cash', async () => { await menu('الصندوق'); await shot('m-cash'); });
await safe('reports', async () => { await menu('التقارير'); await shot('m-reports'); });
await safe('home2', async () => { await p.locator('.bottom-nav button', { hasText: 'الرئيسية' }).click(); await top(); await shot('m-home2'); await p.evaluate(() => document.querySelector('.content')?.scrollTo(0, 520)); await shot('m-home3'); });
await b.close(); console.log('ok');

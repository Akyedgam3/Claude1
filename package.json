{
  "name": "mizan",
  "version": "0.1.0",
  "private": true,
  "description": "ميزان - نظام محاسبة لسطح المكتب يعمل بدون إنترنت",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "license:keygen": "tsx scripts/license-keygen.ts",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win nsis",
    "admin": "tsx admin/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "exceljs": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "main": "out/main/index.js",
  "build": {
    "appId": "sy.mizan.accounting",
    "productName": "Mizan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "1025",
      "shortcutName": "ميزان"
    }
  }
}
